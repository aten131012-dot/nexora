local PURPLE  = Color3.fromRGB(150, 70, 255)
local PURPLE2 = Color3.fromRGB(100, 30, 200)
local PURPLE3 = Color3.fromRGB(60,  10, 140)
local CYAN    = Color3.fromRGB(200, 130, 255)
local BLACK   = Color3.new(0, 0, 0)
local WHITE   = Color3.new(1, 1, 1)
local DARK_BG = Color3.fromRGB(8, 4, 20)

local function new(c, p, par)
    local i = Instance.new(c)
    for k, v in pairs(p) do i[k] = v end
    i.Parent = par
    return i
end
local function tw(o, t, p, s, d)
    local x = TS:Create(o, TweenInfo.new(t, s or Enum.EasingStyle.Quad, d or Enum.EasingDirection.Out), p)
    x:Play()
    return x
end
local function snd(id, vol, loop)
    if not id or id == "" then return end
    local s = Instance.new("Sound")
    s.SoundId, s.Volume, s.Looped = id, vol or 0.6, loop or false
    s.Parent = game:GetService("SoundService")
    s:Play()
    if not loop then game:GetService("Debris"):AddItem(s, 8) end
    return s
end
local function mkGui(name, order)
    pcall(function()
        local old = (gethui and gethui() or game:GetService("CoreGui")):FindFirstChild(name)
        if old then old:Destroy() end
    end)
    local g = Instance.new("ScreenGui")
    g.Name, g.ResetOnSpawn, g.IgnoreGuiInset, g.DisplayOrder = name, false, true, order
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local ok = pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not ok or not g.Parent then g.Parent = LP:WaitForChild("PlayerGui") end
    return g
end

local function bolt(parent, a, b, color, th, segs, z)
    local f = Instance.new("Folder")
    f.Parent = parent
    local d = b - a
    local perp = Vector2.new(-d.Y, d.X).Unit
    local pts = {a}
    for i = 1, segs - 1 do
        pts[#pts + 1] = a:Lerp(b, i / segs) + perp * math.random(-20, 20)
    end
    pts[#pts + 1] = b
    for i = 1, #pts - 1 do
        local p1, p2 = pts[i], pts[i + 1]
        local v = p2 - p1
        local s = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2),
            Size = UDim2.fromOffset(v.Magnitude + 2, th),
            Rotation = math.deg(math.atan2(v.Y, v.X)),
            BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 1}, f)
        new("UIStroke", {Color = color, Thickness = th * 1.5, Transparency = 0.6}, s)
    end
    return f
end
local function storm(parent, w, h, color, alive)
    task.spawn(function()
        while alive.on and parent.Parent do
            local f = bolt(parent, Vector2.new(math.random(0, w), 0), Vector2.new(math.random(0, w), h), color, 2, 8, 1)
            task.wait(0.09)
            f:Destroy()
            task.wait(math.random(3, 10) / 10)
        end
    end)
end


local function DropBox()
    local old = workspace:FindFirstChild("NEXORA_BOX")
    if old then old:Destroy() end
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local target = (hrp.CFrame * CFrame.new(0, 0, -12)).Position

    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {char}
    local hit = workspace:Raycast(target + Vector3.new(0, 50, 0), Vector3.new(0, -300, 0), rp)
    local groundY = hit and hit.Position.Y or (hrp.Position.Y - 3)
    local landPos = Vector3.new(target.X, groundY + 3.5, target.Z)

    local box = new("Part", {Name = "NEXORA_BOX", Size = Vector3.new(4, 4, 4), Anchored = true,
        CanCollide = true, Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(15, 15, 15),
        CFrame = CFrame.new(landPos + Vector3.new(0, 140, 0)) * CFrame.Angles(0.8, 0.5, 0.3)}, workspace)
    for _, f in ipairs(Enum.NormalId:GetEnumItems()) do
        new("Decal", {Texture = CFG.BOX_IMAGE, Face = f}, box)
    end
    new("PointLight", {Color = PURPLE, Range = 18, Brightness = 3}, box)
    local pe = new("ParticleEmitter", {Color = ColorSequence.new(PURPLE), Rate = 60,
        Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(2, 6),
        Size = NumberSequence.new(1, 0), LightEmission = 1}, box)

    tw(box, 1.8, {CFrame = CFrame.new(landPos)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
    pe.Rate = 5
    snd(SFX.land, 1)

    local ring = new("Part", {Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2, 2), Anchored = true,
        CanCollide = false, Material = Enum.Material.Neon, Color = PURPLE,
        CFrame = CFrame.new(landPos.X, groundY + 0.3, landPos.Z) * CFrame.Angles(0, 0, math.rad(90))}, workspace)
    tw(ring, 0.8, {Size = Vector3.new(0.3, 40, 40), Transparency = 1})
    game:GetService("Debris"):AddItem(ring, 1)

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _ = 1, 14 do
            hum.CameraOffset = Vector3.new(math.random(-10, 10) / 20, math.random(-10, 10) / 20, 0)
            task.wait(0.03)
        end
        hum.CameraOffset = Vector3.new()
    end

    local pp = new("ProximityPrompt", {ActionText = "OPEN MAP LIST", ObjectText = "NEXORA BOX",
        KeyboardKeyCode = Enum.KeyCode.E, HoldDuration = 0, MaxActivationDistance = 14,
        RequiresLineOfSight = false}, box)
    pp.Triggered:Connect(function() OpenMaps() end)

    local mouse = LP:GetMouse()
    mouse.Button1Down:Connect(function()
        if mouse.Target == box then OpenMaps() end
    end)

    task.spawn(function()
        local t = 0
        while box.Parent do
            t += task.wait()
            box.CFrame = CFrame.new(landPos + Vector3.new(0, math.sin(t * 2) * 0.6, 0)) * CFrame.Angles(0, t * 0.8, 0)
        end
    end)
end

local function Cutscene(gui)
    local cam = workspace.CurrentCamera
    local vs, fov = cam.ViewportSize, cam.FieldOfView
    local blur = new("BlurEffect", {Size = 0}, Lighting)
    local dark = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK,
        BackgroundTransparency = 1, BorderSizePixel = 0}, gui)
    local top = new("Frame", {Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 5}, gui)
    local bot = new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 5}, gui)
    local flash = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE,
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9}, gui)
    local cut = new("TextLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45),
        Size = UDim2.fromScale(0.9, 0.16), BackgroundTransparency = 1, Text = "", TextColor3 = PURPLE,
        Font = Enum.Font.GothamBlack, TextScaled = true, ZIndex = 6}, gui)
    local sub = new("TextLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.56),
        Size = UDim2.fromScale(0.8, 0.05), BackgroundTransparency = 1, Text = "", TextColor3 = WHITE,
        Font = Enum.Font.GothamBold, TextScaled = true, ZIndex = 6}, gui)
    new("UIStroke", {Color = CYAN, Thickness = 2, Transparency = 0.3}, cut)

    local function strike(n)
        for _ = 1, n do
            local x = math.random(0, math.floor(vs.X))
            local f = bolt(gui, Vector2.new(x, 0), Vector2.new(x + math.random(-150, 150), math.floor(vs.Y)), PURPLE, 4, 12, 7)
            task.delay(0.15, function() f:Destroy() end)
        end
    end

    snd(SFX.boot, 0.8)
    tw(dark, 0.6, {BackgroundTransparency = 0.3})
    tw(blur, 0.8, {Size = 24})
    tw(top, 0.7, {Size = UDim2.new(1, 0, 0.12, 0)})
    tw(bot, 0.7, {Size = UDim2.new(1, 0, 0.12, 0)})
    tw(cam, 1.8, {FieldOfView = fov - 20})
    task.wait(0.8)

    local word, chars = "NEXORA", "#@$%&*<>/|01"
    for n = 0, #word do
        for _ = 1, 3 do
            local s = word:sub(1, n)
            for _ = n + 1, #word do
                local r = math.random(#chars)
                s = s .. chars:sub(r, r)
            end
            cut.Text = s
            task.wait(0.03)
        end
    end
    cut.Text = word
    snd(SFX.boom, 0.9)
    strike(3)
    flash.BackgroundTransparency = 0.2
    tw(flash, 0.5, {BackgroundTransparency = 1})
    for _ = 1, 12 do
        cut.Position = UDim2.fromScale(0.5 + math.random(-10, 10) / 1000, 0.45 + math.random(-10, 10) / 1000)
        task.wait(0.02)
    end
    cut.Position = UDim2.fromScale(0.5, 0.45)

    sub.Text = "SCANNING MAP..."
    snd(SFX.boot, 0.6)
    task.wait(0.8)
    sub.Text = "SCRIPT NOT FOUND"
    sub.TextColor3 = Color3.fromRGB(255, 70, 90)
    snd(SFX.glitch, 0.9)
    strike(2)
    task.wait(1)

    tw(cut, 0.5, {TextTransparency = 1})
    tw(sub, 0.5, {TextTransparency = 1})
    tw(top, 0.6, {Size = UDim2.new(1, 0, 0, 0)})
    tw(bot, 0.6, {Size = UDim2.new(1, 0, 0, 0)})
    tw(cam, 1.2, {FieldOfView = fov})
    task.wait(0.6)
    cut:Destroy() sub:Destroy()
    return blur, dark

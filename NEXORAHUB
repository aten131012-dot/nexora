        Font = Enum.Font.GothamBold, TextScaled = true, ZIndex = 6}, gui)
    new("UIStroke", {Color = PURPLE2, Thickness = 2, Transparency = 0.3}, cut)

    local function strike(n)
        for _ = 1, n do
            local x = math.random(0, math.floor(vs.X))
            local f = bolt(gui, Vector2.new(x, 0), Vector2.new(x + math.random(-150, 150), math.floor(vs.Y)), PURPLE, 4, 12, 7)
            task.delay(0.15, function() f:Destroy() end)
        end
    end

    snd(SFX.boot, 0.8)
    tw(dark, 0.6, {BackgroundTransparency = 0.3})
    tw(blur, 0.8, {Size = 24})
    tw(top, 0.7, {Size = UDim2.new(1, 0, 0.12, 0)})
    tw(bot, 0.7, {Size = UDim2.new(1, 0, 0.12, 0)})
    tw(cam, 1.8, {FieldOfView = fov - 20})
    task.wait(0.8)

    local word, chars = "NEXORA", "#@$%&*<>/|01"
    for n = 0, #word do
        for _ = 1, 3 do
            local s = word:sub(1, n)
            for _ = n + 1, #word do
                local r = math.random(#chars)
                s = s .. chars:sub(r, r)
            end
            cut.Text = s
            task.wait(0.03)
        end
    end
    cut.Text = word
    snd(SFX.boom, 0.9)
    strike(3)
    flash.BackgroundTransparency = 0.2
    tw(flash, 0.5, {BackgroundTransparency = 1})
    for _ = 1, 12 do
        cut.Position = UDim2.fromScale(0.5 + math.random(-10, 10) / 1000, 0.45 + math.random(-10, 10) / 1000)
        task.wait(0.02)
    end
    cut.Position = UDim2.fromScale(0.5, 0.45)

    sub.Text = "SCANNING MAP..."
    snd(SFX.boot, 0.6)
    task.wait(0.8)
    sub.Text = "SCRIPT NOT FOUND"
    sub.TextColor3 = Color3.fromRGB(255, 70, 90)
    snd(SFX.glitch, 0.9)
    strike(2)
    task.wait(1)

    tw(cut, 0.5, {TextTransparency = 1})
    tw(sub, 0.5, {TextTransparency = 1})
    tw(top, 0.6, {Size = UDim2.new(1, 0, 0, 0)})
    tw(bot, 0.6, {Size = UDim2.new(1, 0, 0, 0)})
    tw(cam, 1.2, {FieldOfView = fov})
    task.wait(0.6)
    cut:Destroy() sub:Destroy()
    return blur, dark
end

local function ShowNotice()
    local T = {
        EN = {title = "MAP NOT SUPPORTED", sub = "THIS MAP HAS NO SCRIPT YET",
              desc = "Join our Discord to request a script for this map.",
              copy = "COPY DISCORD LINK", copied = "COPIED!", lang = "ภาษาไทย"},
        TH = {title = "ยังไม่รองรับแมพนี้", sub = "แมพนี้ยังไม่มีสคริปต์",
              desc = "เข้า Discord เพื่อขอสคริปต์แมพนี้ได้เลย",
              copy = "คัดลอกลิงก์ DISCORD", copied = "คัดลอกแล้ว!", lang = "English"},
    }
    local alive = {on = true}
    local gui = mkGui("NEXORA_NOTICE", 999)
    local music = snd(CFG.MUSIC, 0.5, true)
    local blur, dark = Cutscene(gui)
    local vs = workspace.CurrentCamera.ViewportSize
    local W, H = 480, 320

    local panel = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, 4), BackgroundColor3 = Color3.fromRGB(7, 5, 14), BorderSizePixel = 0,
        ClipsDescendants = true, ZIndex = 3}, gui)
    new("UIScale", {Scale = math.min(1, vs.X * 0.92 / W, vs.Y * 0.92 / H)}, panel)
    local stroke = new("UIStroke", {Color = PURPLE, Thickness = 2}, panel)
    TS:Create(stroke, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {Transparency = 0.7, Color = CYAN}):Play()

    local bg = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ClipsDescendants = true, ZIndex = 1}, panel)
    storm(bg, W, H, PURPLE, alive)
    local scan = new("Frame", {Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = PURPLE,
        BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 1}, bg)
    TS:Create(scan, TweenInfo.new(2.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
        {Position = UDim2.fromOffset(0, H)}):Play()

    local bar = new("Frame", {Size = UDim2.fromOffset(W, 28), BackgroundColor3 = PURPLE3,
        BorderSizePixel = 0, ZIndex = 2}, panel)
    new("UIStroke", {Color = PURPLE, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, bar)
    new("TextLabel", {Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(200, 28), BackgroundTransparency = 1,
        Text = "// NEXORA.SYS :: ERR_404", TextColor3 = CYAN, Font = Enum.Font.Code, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3}, bar)

    local function btn(par, x, y, w, h, bgc, fg, size)
        local b = new("TextButton", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
            BackgroundColor3 = bgc, TextColor3 = fg, Font = Enum.Font.GothamBlack, TextSize = size,
            BorderSizePixel = 0, ZIndex = 3}, par)
        new("UIStroke", {Color = PURPLE, Thickness = 1}, b)
        return b
    end
    local function lbl(y, h, size, font, color)
        return new("TextLabel", {Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(W, h),
            BackgroundTransparency = 1, TextColor3 = color or CYAN, Font = font, TextSize = size,
            TextWrapped = true, ZIndex = 2}, panel)
    end
    local langBtn = btn(bar, 392, 3, 84, 22, PURPLE2, CYAN, 11)
    local muteBtn = btn(bar, 300, 3, 84, 22, PURPLE2, CYAN, 11)
    muteBtn.Text = "MUSIC"
    muteBtn.Visible = music ~= nil

    local title = lbl(48, 40, 30, Enum.Font.GothamBlack, PURPLE)
    local sub = lbl(92, 24, 16, Enum.Font.GothamBold, CYAN)
    local desc = lbl(120, 30, 14, Enum.Font.Gotham, Color3.fromRGB(180, 130, 255))

    local linkBox = new("TextLabel", {Position = UDim2.fromOffset(30, 162), Size = UDim2.fromOffset(420, 34),
        BackgroundColor3 = Color3.fromRGB(14, 8, 30), Text = CFG.DISCORD, TextColor3 = CYAN,
        Font = Enum.Font.Code, TextSize = 15, BorderSizePixel = 0, ZIndex = 2}, panel)
    new("UIStroke", {Color = PURPLE, Thickness = 1}, linkBox)
    local copyBtn = btn(panel, 30, 206, 420, 42, PURPLE2, CYAN, 15)
    local close = btn(panel, 220, 264, 40, 40, Color3.fromRGB(35, 8, 20), Color3.fromRGB(255, 90, 110), 30)
    close.Text = "×"
    local cs = close:FindFirstChildOfClass("UIStroke")
    cs.Color, cs.Thickness = Color3.fromRGB(255, 70, 100), 2
    TS:Create(cs, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {Thickness = 5, Transparency = 0.6}):Play()

    task.spawn(function()
        while alive.on do
            task.wait(math.random(15, 40) / 10)
            local o = title.Position
            for _ = 1, 5 do
                title.Position = o + UDim2.fromOffset(math.random(-5, 5), 0)
                title.TextColor3 = (math.random() < 0.5) and CYAN or PURPLE
                task.wait(0.03)
            end
            title.Position, title.TextColor3 = o, PURPLE
        end
    end)

    local function applyLang()
        local L = T[LANG]
        title.Text, sub.Text, desc.Text = L.title, L.sub, L.desc
        copyBtn.Text, langBtn.Text = L.copy, L.lang
    end
    applyLang()
    langBtn.MouseButton1Click:Connect(function()
        snd(SFX.click, 0.6)
        LANG = (LANG == "EN") and "TH" or "EN"
        applyLang()
    end)
    local muted = false
    muteBtn.MouseButton1Click:Connect(function()
        snd(SFX.click, 0.6)
        muted = not muted
        if music then music.Volume = muted and 0 or 0.5 end
        muteBtn.TextTransparency = muted and 0.6 or 0
    end)
    local busy = false
    copyBtn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        snd(SFX.click, 0.8)
        pcall(function() (setclipboard or toclipboard)(CFG.DISCORD) end)
        copyBtn.Text = T[LANG].copied
        copyBtn.BackgroundColor3 = Color3.fromRGB(40, 190, 120)
        task.wait(1.5)
        copyBtn.Text = T[LANG].copy
        copyBtn.BackgroundColor3 = PURPLE2
        busy = false
    end)

    close.MouseButton1Click:Connect(function()
        if not alive.on then return end
        alive.on = false
        snd(SFX.boom, 1)
        if music then
            tw(music, 0.8, {Volume = 0})
            task.delay(1, function() music:Destroy() end)
        end
        for _ = 1, 4 do
            local bx = math.random(0, math.floor(vs.X))
            local f = bolt(gui, Vector2.new(bx, 0), Vector2.new(math.random(0, math.floor(vs.X)), math.floor(vs.Y)), PURPLE, 5, 12, 8)
            task.delay(0.2, function() f:Destroy() end)
        end
        local fl = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = PURPLE,
            BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 9}, gui)
        tw(fl, 0.5, {BackgroundTransparency = 1})
        tw(panel, 0.4, {Size = UDim2.fromOffset(W, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        tw(blur, 0.5, {Size = 0})
        tw(dark, 0.5, {BackgroundTransparency = 1})
        task.wait(0.6)
        blur:Destroy()
        gui:Destroy()
        DropBox()
    end)

    snd(SFX.open, 0.8)
    tw(panel, 0.6, {Size = UDim2.fromOffset(W, H)}, Enum.EasingStyle.Back)
end

-- ===== เลือกสคริปต์ตามแมพ =====
local url = Scripts[game.PlaceId] or Scripts[game.GameId]

if url and tostring(url):find("^http") then
    local ok, err = pcall(function() loadstring(game:HttpGet(url))() end)
    if not ok then warn("[NEXORA] โหลดสคริปต์ไม่สำเร็จ: " .. tostring(err)) end
else
    task.spawn(ShowNotice)
end

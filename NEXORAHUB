local function DropBox()
    local old = workspace:FindFirstChild("NEXORA_BOX")
    if old then old:Destroy() end
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local target = (hrp.CFrame * CFrame.new(0, 0, -12)).Position

    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {char}
    local hit = workspace:Raycast(target + Vector3.new(0, 50, 0), Vector3.new(0, -300, 0), rp)
    local groundY = hit and hit.Position.Y or (hrp.Position.Y - 3)
    local landPos = Vector3.new(target.X, groundY + 3.5, target.Z)

    local box = new("Part", {Name = "NEXORA_BOX", Size = Vector3.new(4, 4, 4), Anchored = true,
        CanCollide = true, Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(15, 5, 30),
        CFrame = CFrame.new(landPos + Vector3.new(0, 140, 0)) * CFrame.Angles(0.8, 0.5, 0.3)}, workspace)
    for _, f in ipairs(Enum.NormalId:GetEnumItems()) do
        new("Decal", {Texture = CFG.BOX_IMAGE, Face = f}, box)
    end
    new("PointLight", {Color = PURPLE, Range = 20, Brightness = 4}, box)
    -- particle ม่วง
    local pe = new("ParticleEmitter", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, PURPLE),
            ColorSequenceKeypoint.new(0.5, CYAN),
            ColorSequenceKeypoint.new(1, PURPLE2),
        }),
        Rate = 80, Lifetime = NumberRange.new(0.5, 1.4),
        Speed = NumberRange.new(3, 8),
        Size = NumberSequence.new(1.2, 0),
        LightEmission = 1, Transparency = NumberSequence.new(0, 1)
    }, box)

    tw(box, 1.8, {CFrame = CFrame.new(landPos)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
    pe.Rate = 6
    snd(SFX.land, 1)

    -- วงแสงม่วงตอนลงพื้น
    local ring = new("Part", {Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2, 2), Anchored = true,
        CanCollide = false, Material = Enum.Material.Neon, Color = PURPLE,
        CFrame = CFrame.new(landPos.X, groundY + 0.3, landPos.Z) * CFrame.Angles(0, 0, math.rad(90))}, workspace)
    tw(ring, 0.8, {Size = Vector3.new(0.3, 40, 40), Transparency = 1})
    game:GetService("Debris"):AddItem(ring, 1)

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _ = 1, 14 do
            hum.CameraOffset = Vector3.new(math.random(-10, 10) / 20, math.random(-10, 10) / 20, 0)
            task.wait(0.03)
        end
        hum.CameraOffset = Vector3.new()
    end

    -- กล่องลอยหมุนแต่กดไม่ได้ — ใช้ ProximityPrompt + Mouse เปิด map list เท่านั้น
    local pp = new("ProximityPrompt", {ActionText = "OPEN MAP LIST", ObjectText = "NEXORA BOX",
        KeyboardKeyCode = Enum.KeyCode.E, HoldDuration = 0, MaxActivationDistance = 14,
        RequiresLineOfSight = false}, box)
    pp.Triggered:Connect(function() OpenMaps() end)

    local mouse = LP:GetMouse()
    mouse.Button1Down:Connect(function()
        if mouse.Target == box then OpenMaps() end
    end)

    -- หมุนลอยตลอด
    task.spawn(function()
        local t = 0
        while box.Parent do
            t += task.wait()
            box.CFrame = CFrame.new(landPos + Vector3.new(0, math.sin(t * 2) * 0.6, 0)) * CFrame.Angles(0, t * 0.8, 0)
        end
    end)
end


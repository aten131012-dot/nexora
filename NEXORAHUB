        Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 5}, gui)
    local flash = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = PURPLE,

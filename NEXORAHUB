local Active = {}
local function FetchPlayers(m)
    pcall(function()
        if not m.uid then
            if m.place == game.PlaceId and game.GameId ~= 0 then
                m.uid = game.GameId
            else
                m.uid = HS:JSONDecode(game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. m.place .. "/universe")).universeId
            end
        end
        local g = HS:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games?universeIds=" .. m.uid))
        m.playing = g.data[1].playing
    end)
end

for id, link in pairs(Scripts) do
    if tostring(link):find("^http") then
        task.spawn(function()
            local ok, info = pcall(function() return MPS:GetProductInfo(id) end)
            if not (ok and info and info.Name) then return end
            if info.AssetTypeId and info.AssetTypeId ~= 9 then return end
            local m = {name = info.Name, place = id, url = link}
            if info.IconImageAssetId and info.IconImageAssetId ~= 0 then
                m.icon = "rbxassetid://" .. info.IconImageAssetId
                task.spawn(function() pcall(function() CP:PreloadAsync({m.icon}) end) end)
            end
            table.insert(Active, m)
            FetchPlayers(m)
        end)
    end
end


    -- ช่องแสดงลิงก์ Discord และปุ่มคัดลอกลิงก์
    local linkBox = new("TextLabel", {Position = UDim2.fromOffset(25, 188), Size = UDim2.fromOffset(W - 50, 30),
        BackgroundColor3 = Color3.fromRGB(14, 8, 30), Text = CFG.DISCORD, TextColor3 = CYAN,
        Font = Enum.Font.Code, TextSize = 13, BorderSizePixel = 0, ZIndex = 2}, panel)
    new("UICorner", {CornerRadius = UDim.new(0, 6)}, linkBox)
    new("UIStroke", {Color = PURPLE, Thickness = 1}, linkBox)

    local copyBtn = btn(panel, 25, 224, W - 50, 34, PURPLE2, CYAN, 13)

    -- ปุ่มปิดอยู่ล่างสุด
    local close = btn(panel, (W / 2) - 18, 268, 36, 36, Color3.fromRGB(35, 8, 20), Color3.fromRGB(255, 90, 110), 20)
    close.Text = "×"
    local cs = close:FindFirstChildOfClass("UIStroke")
    if cs then cs.Color, cs.Thickness = Color3.fromRGB(255, 70, 100), 2 end

    local function applyLang()
        local L = T[LANG]
        sub.Text, desc.Text = L.sub, L.desc
        copyBtn.Text, langBtn.Text = L.copy, L.lang
    end
    applyLang()

    langBtn.MouseButton1Click:Connect(function()
        snd(SFX.click, 0.6)
        LANG = (LANG == "EN") and "TH" or "EN"
        applyLang()
    end)

    local busy = false
    copyBtn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        snd(SFX.click, 0.8)
        pcall(function() (setclipboard or toclipboard)(CFG.DISCORD) end)
        copyBtn.Text = T[LANG].copied
        copyBtn.BackgroundColor3 = Color3.fromRGB(40, 190, 120)
        task.wait(1.5)
        copyBtn.Text = T[LANG].copy
        copyBtn.BackgroundColor3 = PURPLE2
        busy = false
    end)

    close.MouseButton1Click:Connect(function()
        if not alive.on then return end
        alive.on = false
        snd(SFX.open, 0.8)
        tw(panel, 0.3, {Size = UDim2.fromOffset(W, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.wait(0.35)
        gui:Destroy()
        OpenMaps() -- เปิดหน้าต่างเลือกแมพต่อเมื่อปิดกล่องนี้
    end)

    tw(panel, 0.5, {Size = UDim2.fromOffset(W, H)}, Enum.EasingStyle.Back)
end

-- ===== รันสคริปต์ =====
local url = Scripts[game.PlaceId] or Scripts[game.GameId]
if url and tostring(url):find("^http") then
    local ok, err = pcall(function() loadstring(game:HttpGet(url))() end)
    if not ok then warn("[NEXORA] โหลดสคริปต์ไม่สำเร็จ: " .. tostring(err)) end
else
    task.spawn(ShowNotice)
end

                    BackgroundColor3 = Color3.fromRGB(20, 8, 40), BorderSizePixel = 0,
                    ScaleType = Enum.ScaleType.Crop, Image = m.icon or ""}, face)
                if not m.icon and m.uid then
                    img.Image = ("rbxthumb://type=GameIcon&id=%d&w=150&h=150"):format(m.uid)
                end
                new("TextLabel", {Position = UDim2.fromOffset(6, 80), Size = UDim2.new(1, -12, 0, 16),
                    BackgroundTransparency = 1, Text = nm, TextColor3 = CYAN, Font = Enum.Font.GothamBold,
                    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd}, face)
                local cnt = new("TextLabel", {Position = UDim2.fromOffset(6, 96), Size = UDim2.new(1, -12, 0, 14),
                    BackgroundTransparency = 1, Text = "", TextColor3 = Color3.fromRGB(180, 130, 255),
                    Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd}, face)
                local go = new("TextButton", {Position = UDim2.fromOffset(6, 114), Size = UDim2.new(1, -12, 0, 22),
                    BackgroundColor3 = PURPLE2, TextColor3 = CYAN, Text = UIT[LANG].tp, Font = Enum.Font.GothamBlack,
                    TextSize = 12, BorderSizePixel = 0}, face)
                new("UIStroke", {Color = PURPLE, Thickness = 1}, go)
                cards[m.place] = {cnt = cnt, img = img}
                setCount(m)

                face.MouseEnter:Connect(function()
                    tw(face, 0.12, {Position = UDim2.fromOffset(-3, -3), BackgroundColor3 = Color3.fromRGB(25, 10, 55)})
                end)
                face.MouseLeave:Connect(function()
                    tw(face, 0.12, {Position = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.fromRGB(14, 6, 30)})
                end)

                local busy = false
                go.MouseButton1Click:Connect(function()
                    if busy then return end
                    snd(SFX.click, 0.7)
                    if m.place == game.PlaceId then
                        go.Text = UIT[LANG].here
                        task.delay(1.5, function() if go.Parent then go.Text = UIT[LANG].tp end end)
                        return
                    end
                    busy = true
                    go.Text = UIT[LANG].going
                    if CFG.LOADER_URL ~= "" and queue_on_teleport then
                        pcall(queue_on_teleport, 'loadstring(game:HttpGet("' .. CFG.LOADER_URL .. '"))()')
                    end
                    local reason
                    local conn = TPS.TeleportInitFailed:Connect(function(_, res, msg)
                        reason = tostring(msg ~= "" and msg or res)
                    end)
                    local ok, err = pcall(function() TPS:Teleport(m.place, LP) end)
                    if not ok then reason = tostring(err) end
                    local t = 0
                    while t < 10 and not reason and go.Parent do
                        task.wait(0.25)
                        t += 0.25
                    end
                    conn:Disconnect()
                    if go.Parent then
                        reason = reason or "timeout"
                        warn("[NEXORA] teleport: " .. reason)
                        go.Text = UIT[LANG].fail
                        cnt.Text = reason:sub(1, 30)
                        cnt.TextColor3 = Color3.fromRGB(255, 90, 90)
                        task.wait(2.5)
                        if go.Parent then
                            go.Text = UIT[LANG].tp
                            cnt.TextColor3 = Color3.fromRGB(180, 130, 255)
                            setCount(m)
                        end
                    end
                    busy = false
                end)
            end
